# Database. Hosted example: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# Test database only. The name must end in _test; the suite truncates its tables.
# TEST_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas_test

# Uploaded files and the /files mount
UPLOAD_DIR=./uploads

# CORS for the Next.js dev server
CORS_ORIGINS=http://localhost:3000

# Upload limit in megabytes
MAX_UPLOAD_MB=15

# Related-site score: alpha * CLIP + (1 - alpha) * tag Jaccard
RELATED_CLIP_WEIGHT=0.6

# Worker retry budget and lease
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=300
JOB_RETRY_BACKOFF_SECONDS=10

# Fixed demo reviewer identifiers (audit labels, not authentication)
REVIEWERS=asha,ravi,guest

# CLIP feature tagging: per-label thresholds live in backend/app/feature_prompts.json.
# null means the feature is never emitted. MAX_FEATURES caps accepted tags per image.
MAX_FEATURES=4

# Model overrides (optional)
CLIP_MODEL_NAME=clip-ViT-B-32
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
MODEL_DEVICE=

# Roboflow export (optional, scripts/dataset/download_roboflow.py)
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
