# Database. Configure the password locally in .env; URL-encode special characters.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.nkfhcraciyqdmkeedkjb.supabase.co:5432/postgres?sslmode=require

# Test database only. The name must end in _test; the suite truncates its tables.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.nkfhcraciyqdmkeedkjb.supabase.co:5432/heritage_atlas_test?sslmode=require

# Uploaded files and the /files mount
UPLOAD_DIR=./uploads

# CORS for the Next.js dev server
CORS_ORIGINS=http://localhost:3000

# Upload limit in megabytes
MAX_UPLOAD_MB=15

# Related-site score: alpha * CLIP + (1 - alpha) * tag Jaccard
RELATED_CLIP_WEIGHT=0.6

# Worker retry budget and lease
JOB_MAX_RETRIES=3
JOB_LEASE_SECONDS=300
JOB_RETRY_BACKOFF_SECONDS=10

# Fixed demo reviewer identifiers (audit labels, not authentication)
REVIEWERS=asha,ravi,guest

# CLIP feature tagging: per-label thresholds live in backend/app/feature_prompts.json.
# null means the feature is never emitted. MAX_FEATURES caps accepted tags per image.
MAX_FEATURES=4

# Model overrides (optional)
CLIP_MODEL_NAME=clip-ViT-B-32
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
MODEL_DEVICE=

# Optional Ask Heritage Atlas Gemini assistant (server-side only)
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.3
AI_MAX_HISTORY_MESSAGES=10
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_RETRIES=1
AI_MAX_CONCURRENCY=2

# Roboflow export (optional, scripts/dataset/download_roboflow.py)
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
